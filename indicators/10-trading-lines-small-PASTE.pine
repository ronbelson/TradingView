//@version=6
indicator("Trading Lines", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500)

// Trading Lines - four engines RSI 72 + RSI 14 + RSI 7 + RSI 3 (gray bubbles only)
// Bridge 72-14: red window, whites between, greens back, green forward to white.
// Bridge 14-7: green window, grays between, whites back, white forward to gray.
// Bridge 7-3: one gray high line (older hi to newer hi), one gray low line (older lo to newer lo).
// Author: Ron Belson

gBubbleH = "Bubble horizontal lines"
bubbleHline72 = input.bool(false, "72 forward from each bubble", group=gBubbleH)
bubbleHline14 = input.bool(false, "14 forward from each bubble", group=gBubbleH)
bubbleHline7 = input.bool(false, "7 forward from each bubble", group=gBubbleH)
bubbleHline3 = input.bool(false, "3 forward from each bubble", group=gBubbleH)

rsiOB = input.int(70, "Overbought", minval=51, maxval=100, group="RSI")
rsiOS = input.int(30, "Oversold", minval=1, maxval=49, group="RSI")

g72 = "Engine 72"
rsiLen72 = input.int(72, "RSI length", minval=1, group=g72)
colLow72 = input.color(color.red, "Low line color", group=g72)
colHigh72 = input.color(color.red, "High line color", group=g72)
showLow72 = input.bool(true, "Show low line", group=g72)
showHigh72 = input.bool(true, "Show high line", group=g72)

g14 = "Engine 14"
rsiLen14 = input.int(14, "RSI length", minval=1, group=g14)
colLow14 = input.color(color.green, "Low line color", group=g14)
colHigh14 = input.color(color.green, "High line color", group=g14)
showLow14 = input.bool(true, "Show low line", group=g14)
showHigh14 = input.bool(true, "Show high line", group=g14)

g7 = "Engine 7"
rsiLen7 = input.int(7, "RSI length", minval=1, group=g7)
colLow7 = input.color(color.white, "Low line color", group=g7)
colHigh7 = input.color(color.white, "High line color", group=g7)
showLow7 = input.bool(true, "Show low line", group=g7)
showHigh7 = input.bool(true, "Show high line", group=g7)

g3 = "Engine 3"
rsiLen3 = input.int(3, "RSI length", minval=1, group=g3)
colLow3 = input.color(color.gray, "Low bubble color", group=g3)
colHigh3 = input.color(color.gray, "High bubble color", group=g3)
showLow3 = input.bool(true, "Show low bubbles", group=g3)
showHigh3 = input.bool(true, "Show high bubbles", group=g3)

lineWidth = input.int(2, "Line width", minval=1, maxval=5, group="Style")
extendRight = input.bool(true, "Extend right", group="Style")
showTradingLines = input.bool(true, "Show trading lines", group="Style")
showEndHlines = input.bool(false, "Horizontal from each endpoint", group="Style")
lineReinfPct = input.float(1.0, "Reinforcement near line %", minval=0.1, maxval=5.0, step=0.1, group="Style")

// Fixed bubble label sizes: gray smallest, red largest (draw order bottom to top)
bubbleSz3 = size.tiny
bubbleSz7 = size.small
bubbleSz14 = size.normal
bubbleSz72 = size.large

f_bubblePadMult(string lblSize) =>
    lblSize == size.large ? 1.15 : lblSize == size.normal ? 1.05 : lblSize == size.small ? 0.95 : 0.85
gBridge = "Bridge"
showBridgeHi = input.bool(true, "72-14 high: green to white", group=gBridge)
showBridgeLo = input.bool(true, "72-14 low: green to white", group=gBridge)
showBridgeBHi = input.bool(true, "14-7 high: white to gray", group=gBridge)
showBridgeBLo = input.bool(true, "14-7 low: white to gray", group=gBridge)
showBridgeCHi = input.bool(true, "3 high: older to newer", group=gBridge)
showBridgeCLo = input.bool(true, "3 low: older to newer", group=gBridge)
bridgeGreenCount = input.int(3, "Greens back from red pivot", minval=1, maxval=10, group=gBridge)
bridgeWhiteCount = input.int(3, "Whites back from green pivot", minval=1, maxval=10, group=gBridge)
bridgeWidth = input.int(1, "Bridge line width", minval=1, maxval=4, group=gBridge)

gSig = "Signals"
showSignals = input.bool(true, "Show SHORT / LONG bubbles", group=gSig)
colShort = input.color(color.red, "SHORT color", group=gSig)
colLong = input.color(color.green, "LONG color", group=gSig)
colCancel = input.color(color.gray, "Cancel color", group=gSig)

f_confirmPivotTime(bool confirm, float px, int tm, array<float> pxArr, array<int> timeArr) =>
    if confirm and not na(px) and not na(tm)
        array.push(pxArr, px)
        array.push(timeArr, tm)
    while array.size(pxArr) > 50
        array.shift(pxArr)
        array.shift(timeArr)

f_lineAt(int xBar, int found, float pA, int bA, float pB, int bB) =>
    float out = na
    if found == 2 and not na(pA) and not na(pB) and not na(bA) and not na(bB)
        out := bA == bB ? pB : pA + (pB - pA) * (xBar - bA) / (bB - bA)
    out

f_lineAtTime(int xTime, float pA, int tA, float pB, int tB) =>
    float out = na
    if not na(pA) and not na(pB) and not na(tA) and not na(tB)
        out := tA == tB ? pB : pA + (pB - pA) * (float(xTime - tA) / float(tB - tA))
    out

f_nearLine(float px, int br, float pA, int bA, float pB, int bB) =>
    lineY = f_lineAt(br, 2, pA, bA, pB, bB)
    not na(lineY) and lineY > 0 and math.abs(px - lineY) / lineY * 100.0 <= lineReinfPct

f_nearLineTime(float px, int tm, float pA, int tA, float pB, int tB) =>
    lineY = f_lineAtTime(tm, pA, tA, pB, tB)
    not na(lineY) and lineY > 0 and math.abs(px - lineY) / lineY * 100.0 <= lineReinfPct

f_countClosed(array<int> barArr, bool live) =>
    int n = 0
    sz = array.size(barArr)
    if sz > 0
        for i = 0 to sz - 1
            b = array.get(barArr, i)
            ok = live ? b <= bar_index : b < bar_index
            if ok
                n += 1
    n

f_idxClosedK(array<int> barArr, int k, bool live) =>
    int idx = na
    int cnt = 0
    sz = array.size(barArr)
    if sz > 0
        for i = 0 to sz - 1
            b = array.get(barArr, i)
            ok = live ? b <= bar_index : b < bar_index
            if ok
                if cnt == k
                    idx := i
                    break
                cnt += 1
    idx

f_countClosedTime(array<int> timeArr) =>
    int n = 0
    sz = array.size(timeArr)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(timeArr, i) < time
                n += 1
    n

f_idxClosedKTime(array<int> timeArr, int k) =>
    int idx = na
    int cnt = 0
    sz = array.size(timeArr)
    if sz > 0
        for i = 0 to sz - 1
            if array.get(timeArr, i) < time
                if cnt == k
                    idx := i
                    break
                cnt += 1
    idx

f_nearLineIdx(array<float> pxArr, array<int> barArr, int idx, int iA, int iB) =>
    f_nearLine(array.get(pxArr, idx), array.get(barArr, idx), array.get(pxArr, iA), array.get(barArr, iA), array.get(pxArr, iB), array.get(barArr, iB))

f_resolveLineLeg(pxArr, barArr, timeArr, bool live) =>
    float pA = na
    int tA = na
    int bA = na
    float pB = na
    int tB = na
    int bB = na
    int reinf = 0
    int found = 0
    n = f_countClosed(barArr, live)
    if n >= 2
        lastK = n - 1
        resolved = false
        for pB_k = lastK - 1 to 0
            if pB_k >= 1
                pA_k = pB_k - 1
                iA = f_idxClosedK(barArr, pA_k, live)
                iB = f_idxClosedK(barArr, pB_k, live)
                reinf := lastK - pB_k
                ok = true
                if reinf > 0
                    for j_k = pB_k + 1 to lastK
                        jIdx = f_idxClosedK(barArr, j_k, live)
                        if not f_nearLineIdx(pxArr, barArr, jIdx, iA, iB)
                            ok := false
                            break
                if ok and not na(iA) and not na(iB)
                    pA := array.get(pxArr, iA)
                    tA := array.get(timeArr, iA)
                    bA := array.get(barArr, iA)
                    pB := array.get(pxArr, iB)
                    tB := array.get(timeArr, iB)
                    bB := array.get(barArr, iB)
                    found := 2
                    resolved := true
                    break
        if not resolved
            iA = f_idxClosedK(barArr, n - 2, live)
            iB = f_idxClosedK(barArr, n - 1, live)
            if not na(iA) and not na(iB)
                pA := array.get(pxArr, iA)
                tA := array.get(timeArr, iA)
                bA := array.get(barArr, iA)
                pB := array.get(pxArr, iB)
                tB := array.get(timeArr, iB)
                bB := array.get(barArr, iB)
                found := 2
                reinf := 0
    [found, pA, tA, bA, pB, tB, bB, reinf]

f_resolveLineLegTime(array<float> pxArr, array<int> timeArr) =>
    float pA = na
    int tA = na
    float pB = na
    int tB = na
    int reinf = 0
    int found = 0
    n = f_countClosedTime(timeArr)
    if n >= 2
        lastK = n - 1
        resolved = false
        for pB_k = lastK - 1 to 0
            if pB_k >= 1
                pA_k = pB_k - 1
                iA = f_idxClosedKTime(timeArr, pA_k)
                iB = f_idxClosedKTime(timeArr, pB_k)
                reinf := lastK - pB_k
                ok = true
                if reinf > 0
                    for j_k = pB_k + 1 to lastK
                        jIdx = f_idxClosedKTime(timeArr, j_k)
                        if not f_nearLineTime(array.get(pxArr, jIdx), array.get(timeArr, jIdx), array.get(pxArr, iA), array.get(timeArr, iA), array.get(pxArr, iB), array.get(timeArr, iB))
                            ok := false
                            break
                if ok and not na(iA) and not na(iB)
                    pA := array.get(pxArr, iA)
                    tA := array.get(timeArr, iA)
                    pB := array.get(pxArr, iB)
                    tB := array.get(timeArr, iB)
                    found := 2
                    resolved := true
                    break
        if not resolved
            iA = f_idxClosedKTime(timeArr, n - 2)
            iB = f_idxClosedKTime(timeArr, n - 1)
            if not na(iA) and not na(iB)
                pA := array.get(pxArr, iA)
                tA := array.get(timeArr, iA)
                pB := array.get(pxArr, iB)
                tB := array.get(timeArr, iB)
                found := 2
                reinf := 0
    [found, pA, tA, pB, tB, reinf]

f_rsiEnginePivots(int rsiLen, int obLvl, int osLvl) =>
    rsi = ta.rsi(close, rsiLen)
    ob = rsi >= obLvl
    os = rsi <= osLvl
    var int st = 0
    var float hh = low
    var float ll = high
    var float curHiPx = na
    var float curLoPx = na
    var int curHiTime = na
    var int curLoTime = na
    newHi = false
    movHi = false
    newLo = false
    movLo = false
    if st == 2 and ob
        hh := high
        curHiPx := high
        curHiTime := time
        newHi := true
        st := 1
    if st == 1 and os
        ll := low
        curLoPx := low
        curLoTime := time
        newLo := true
        st := 2
    if ob
        if high >= hh
            hh := high
            curHiPx := high
            curHiTime := time
            movHi := true
        st := 1
    if os
        if low <= ll
            ll := low
            curLoPx := low
            curLoTime := time
            movLo := true
        st := 2
    if st == 1 and high >= hh
        hh := high
        curHiPx := high
        curHiTime := time
        movHi := true
    if st == 2 and low <= ll
        ll := low
        curLoPx := low
        curLoTime := time
        movLo := true
    var array<float> hiPx = array.new_float()
    var array<int> hiTime = array.new_int()
    var array<float> loPx = array.new_float()
    var array<int> loTime = array.new_int()
    f_confirmPivotTime(newLo, curHiPx, curHiTime, hiPx, hiTime)
    f_confirmPivotTime(newHi, curLoPx, curLoTime, loPx, loTime)
    [fHi, pAHi, tAHi, pBHi, tBHi, _rHi] = f_resolveLineLegTime(hiPx, hiTime)
    [fLo, pALo, tALo, pBLo, tBLo, _rLo] = f_resolveLineLegTime(loPx, loTime)
    [fHi, pAHi, tAHi, pBHi, tBHi, fLo, pALo, tALo, pBLo, tBLo]

f_confirmPivot(bool confirm, float px, int br, int tm, array<float> pxArr, array<int> barArr, array<int> timeArr) =>
    if confirm and not na(px) and not na(br) and not na(tm)
        array.push(pxArr, px)
        array.push(barArr, br)
        array.push(timeArr, tm)
    while array.size(pxArr) > 50
        array.shift(pxArr)
        array.shift(barArr)
        array.shift(timeArr)

f_drawPair(bool showLo, bool showHi, array<float> loPx, array<int> loBar, array<int> loTime, array<float> hiPx, array<int> hiBar, array<int> hiTime, color cLo, color cHi, line loLine, line hiLine) =>
    line outLo = loLine
    line outHi = hiLine
    if not na(outLo)
        line.delete(outLo)
        outLo := na
    if not na(outHi)
        line.delete(outHi)
        outHi := na
    ext = extendRight ? extend.right : extend.none
    if showLo
        [foundLo, pA, tA, bA, pB, tB, bB, reinfLo] = f_resolveLineLeg(loPx, loBar, loTime, false)
        wLo = math.min(lineWidth + reinfLo, 5)
        if foundLo == 2 and not na(pA) and not na(pB) and not na(tA) and not na(tB)
            outLo := tA < tB ? line.new(tA, pA, tB, pB, xloc=xloc.bar_time, color=cLo, width=wLo, extend=ext) : line.new(tB, pB, tA, pA, xloc=xloc.bar_time, color=cLo, width=wLo, extend=ext)
    if showHi
        [foundHi, pA, tA, bA, pB, tB, bB, reinfHi] = f_resolveLineLeg(hiPx, hiBar, hiTime, false)
        wHi = math.min(lineWidth + reinfHi, 5)
        if foundHi == 2 and not na(pA) and not na(pB) and not na(tA) and not na(tB)
            outHi := tA < tB ? line.new(tA, pA, tB, pB, xloc=xloc.bar_time, color=cHi, width=wHi, extend=ext) : line.new(tB, pB, tA, pA, xloc=xloc.bar_time, color=cHi, width=wHi, extend=ext)
    [outLo, outHi]

// =============================================================================
// ENGINE 72
// =============================================================================
rsi72 = ta.rsi(close, rsiLen72)
ob72 = rsi72 >= rsiOB
os72 = rsi72 <= rsiOS

var int st72 = 0
var float hh72 = low
var float ll72 = high
var float curHiPx72 = na
var float curLoPx72 = na
var int curHiBar72 = na
var int curHiTime72 = na
var int curLoBar72 = na
var int curLoTime72 = na

newHi72 = false
movHi72 = false
newLo72 = false
movLo72 = false

if st72 == 2 and ob72
    hh72 := high
    curHiPx72 := high
    curHiBar72 := bar_index
    curHiTime72 := time
    newHi72 := true
    st72 := 1

if st72 == 1 and os72
    ll72 := low
    curLoPx72 := low
    curLoBar72 := bar_index
    curLoTime72 := time
    newLo72 := true
    st72 := 2

if ob72
    if high >= hh72
        hh72 := high
        curHiPx72 := high
        curHiBar72 := bar_index
        curHiTime72 := time
        movHi72 := true
    st72 := 1

if os72
    if low <= ll72
        ll72 := low
        curLoPx72 := low
        curLoBar72 := bar_index
        curLoTime72 := time
        movLo72 := true
    st72 := 2

if st72 == 1 and high >= hh72
    hh72 := high
    curHiPx72 := high
    curHiBar72 := bar_index
    curHiTime72 := time
    movHi72 := true

if st72 == 2 and low <= ll72
    ll72 := low
    curLoPx72 := low
    curLoBar72 := bar_index
    curLoTime72 := time
    movLo72 := true

var array<float> hiPx72 = array.new_float()
var array<int> hiBar72 = array.new_int()
var array<int> hiTime72 = array.new_int()
var array<float> loPx72 = array.new_float()
var array<int> loBar72 = array.new_int()
var array<int> loTime72 = array.new_int()

f_confirmPivot(newLo72, curHiPx72, curHiBar72, curHiTime72, hiPx72, hiBar72, hiTime72)
f_confirmPivot(newHi72, curLoPx72, curLoBar72, curLoTime72, loPx72, loBar72, loTime72)

