newHi14 = false
movHi14 = false
newLo14 = false
movLo14 = false

if st14 == 2 and ob14
    hh14 := high
    curHiPx14 := high
    curHiBar14 := bar_index
    curHiTime14 := time
    newHi14 := true
    st14 := 1

if st14 == 1 and os14
    ll14 := low
    curLoPx14 := low
    curLoBar14 := bar_index
    curLoTime14 := time
