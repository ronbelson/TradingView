// TradingView Pine Script v6
// 3-Touch Lines — auto trendlines that pass through N swing points
//
// High (default): pivot highs use High, pivot lows use Low.
// Close: both sides use Close of the swing bar.
// A line is drawn only if at least Min points sit on it (default 3).
// Drawn along the two defining highs so the line sits on the wick; other touches allow a tiny gap.
//
// Author: Ron Belson
//@version=6
indicator("3-Touch Lines", overlay=true, max_bars_back=5000, max_lines_count=200)

gPts = "Points"
priceSrc = input.string("High", "Touch price", options=["High", "Close"], group=gPts, tooltip="High = wick highs/lows. Close = close of the swing bar.")
minTouches = input.int(3, "Min points on line", minval=3, maxval=12, group=gPts)
pivotLen = input.int(5, "Pivot strength", minval=2, maxval=30, group=gPts, tooltip="Bars left and right to confirm a swing.")
lookbackPivots = input.int(24, "Pivots to search", minval=6, maxval=40, group=gPts)
touchPct = input.float(0.06, "Touch tolerance %", minval=0.01, maxval=1.0, step=0.01, group=gPts, tooltip="How far a high may sit from the line. Keep tiny so the line rests on the wick.")

gShow = "Style"
showHi = input.bool(true, "Show high lines", group=gShow)
showLo = input.bool(true, "Show low lines", group=gShow)
maxLines = input.int(6, "Max lines each side", minval=1, maxval=20, group=gShow)
lineWidth = input.int(2, "Line width", minval=1, maxval=5, group=gShow)
extendRight = input.bool(true, "Extend right", group=gShow)
colHi = input.color(color.new(#E65100, 0), "High line color", group=gShow)
colLo = input.color(color.new(#0277BD, 0), "Low line color", group=gShow)

type Pv
    int tm
    int br
    float px

type Cand
    int tLeft
    int tRight
    int nTouch
    array<int> ids
    int tA
    float pA
    int tB
    float pB

f_yAt(int xT, int t1, float p1, int t2, float p2) =>
    float out = na
    if not na(p1) and not na(p2) and not na(t1) and not na(t2)
        out := t1 == t2 ? p2 : p1 + (p2 - p1) * (float(xT - t1) / float(t2 - t1))
    out

f_onLine(float px, int tm, int t1, float p1, int t2, float p2) =>
    y = f_yAt(tm, t1, p1, t2, p2)
    not na(y) and y > 0 and not na(px) and px > 0 and math.abs(px - y) / y * 100.0 <= touchPct

f_idsEqual(array<int> a, array<int> b) =>
    bool ok = array.size(a) == array.size(b)
    na_ = array.size(a)
    if ok and na_ > 0
        for i = 0 to na_ - 1
            if array.get(a, i) != array.get(b, i)
                ok := false
                break
    ok

f_idsSubset(array<int> a, array<int> b) =>
    bool ok = true
    na_ = array.size(a)
    nb = array.size(b)
    if na_ > 0
        for i = 0 to na_ - 1
            av = array.get(a, i)
            bool hit = false
            if nb > 0
                for j = 0 to nb - 1
                    if array.get(b, j) == av
                        hit := true
                        break
            if not hit
                ok := false
                break
    ok

f_better(Cand a, Cand b) =>
    spanA = a.tRight - a.tLeft
    spanB = b.tRight - b.tLeft
    a.nTouch > b.nTouch or (a.nTouch == b.nTouch and spanA > spanB) or (a.nTouch == b.nTouch and spanA == spanB and a.tRight > b.tRight)

f_similar(Cand a, Cand b) =>
    tRef = math.min(a.tLeft, b.tLeft)
    yA0 = f_yAt(tRef, a.tA, a.pA, a.tB, a.pB)
    yB0 = f_yAt(tRef, b.tA, b.pA, b.tB, b.pB)
    yA1 = f_yAt(time, a.tA, a.pA, a.tB, a.pB)
    yB1 = f_yAt(time, b.tA, b.pA, b.tB, b.pB)
    bool ok = false
    if not na(yA0) and not na(yB0) and not na(yA1) and not na(yB1) and yB0 > 0 and yB1 > 0
        near0 = math.abs(yA0 - yB0) / yB0 * 100.0 <= touchPct * 2.5
        near1 = math.abs(yA1 - yB1) / yB1 * 100.0 <= touchPct * 2.5
        ok := near0 and near1
    ok

f_collect(array<Pv> pts) =>
    array<Cand> found = array.new<Cand>()
    n = array.size(pts)
    if n >= minTouches
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                a = array.get(pts, i)
                b = array.get(pts, j)
                if a.tm != b.tm
                    array<int> ids = array.new<int>()
                    int tL = na
                    int tR = na
                    for k = 0 to n - 1
                        c = array.get(pts, k)
                        if f_onLine(c.px, c.tm, a.tm, a.px, b.tm, b.px)
                            array.push(ids, k)
                            if na(tL) or c.tm < tL
                                tL := c.tm
                            if na(tR) or c.tm > tR
                                tR := c.tm
                    cnt = array.size(ids)
                    if cnt >= minTouches and not na(tL) and not na(tR) and tL < tR
                        bool dup = false
                        nf = array.size(found)
                        if nf > 0
                            for m = 0 to nf - 1
                                if f_idsEqual(array.get(found, m).ids, ids)
                                    dup := true
                                    break
                        if not dup
                            array.push(found, Cand.new(tL, tR, cnt, ids, a.tm, a.px, b.tm, b.px))
    array<Cand> kept = array.new<Cand>()
    nf2 = array.size(found)
    if nf2 > 0
        for a = 0 to nf2 - 1
            ca = array.get(found, a)
            bool subset = false
            for b = 0 to nf2 - 1
                if a != b
                    cb = array.get(found, b)
                    if not f_idsEqual(ca.ids, cb.ids) and f_idsSubset(ca.ids, cb.ids) and cb.nTouch >= ca.nTouch
                        subset := true
                        break
            if not subset
                array.push(kept, ca)
    array<Cand> ranked = array.new<Cand>()
    nK = array.size(kept)
    if nK > 0
        array<bool> used = array.new_bool(nK, false)
        takeN = math.min(maxLines * 3, nK)
        for pick = 1 to takeN
            int best = -1
            for i = 0 to nK - 1
                if not array.get(used, i)
                    if best < 0
                        best := i
                    else if f_better(array.get(kept, i), array.get(kept, best))
                        best := i
            if best < 0
                break
            array.set(used, best, true)
            array.push(ranked, array.get(kept, best))
    array<Cand> out = array.new<Cand>()
    nR = array.size(ranked)
    if nR > 0
        for i = 0 to nR - 1
            if array.size(out) >= maxLines
                break
            c = array.get(ranked, i)
            bool clash = false
            nO = array.size(out)
            if nO > 0
                for j = 0 to nO - 1
                    if f_similar(c, array.get(out, j))
                        clash := true
                        break
            if not clash
                array.push(out, c)
    out

f_clearLines(array<line> arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            line.delete(array.get(arr, i))
    array.clear(arr)

f_drawSide(array<Cand> cands, array<line> linesArr, color col) =>
    f_clearLines(linesArr)
    ext = extendRight ? extend.right : extend.none
    nC = array.size(cands)
    if nC > 0
        for i = 0 to nC - 1
            c = array.get(cands, i)
            yL = f_yAt(c.tLeft, c.tA, c.pA, c.tB, c.pB)
            yR = f_yAt(c.tRight, c.tA, c.pA, c.tB, c.pB)
            if not na(yL) and not na(yR)
                w = math.min(lineWidth + math.max(c.nTouch - minTouches, 0), 5)
                ln = line.new(c.tLeft, yL, c.tRight, yR, xloc=xloc.bar_time, color=col, width=w, extend=ext, style=line.style_solid)
                array.push(linesArr, ln)

useHigh = priceSrc == "High"
hiSeries = useHigh ? high : close
loSeries = useHigh ? low : close

ph = ta.pivothigh(hiSeries, pivotLen, pivotLen)
pl = ta.pivotlow(loSeries, pivotLen, pivotLen)

var array<Pv> hiPts = array.new<Pv>()
var array<Pv> loPts = array.new<Pv>()
var array<line> hiLines = array.new<line>()
var array<line> loLines = array.new<line>()

newHi = not na(ph)
newLo = not na(pl)

if newHi
    array.push(hiPts, Pv.new(time[pivotLen], bar_index - pivotLen, ph))
    while array.size(hiPts) > lookbackPivots
        array.shift(hiPts)

if newLo
    array.push(loPts, Pv.new(time[pivotLen], bar_index - pivotLen, pl))
    while array.size(loPts) > lookbackPivots
        array.shift(loPts)

if newHi and showHi
    hiCands = f_collect(hiPts)
    f_drawSide(hiCands, hiLines, colHi)

if newLo and showLo
    loCands = f_collect(loPts)
    f_drawSide(loCands, loLines, colLo)

if not showHi
    f_clearLines(hiLines)

if not showLo
    f_clearLines(loLines)
