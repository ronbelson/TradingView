[c2, mf2, mm2, ms2, mx2, lf2, lm2, ls2, dp2, r142, r72, ml2, sl2, hi2, rh2, rl2, rp2, stk2, pvs2, fl2, bu2, bp2, ph2, ph22, pl2, pl22, srh2, srl2, zc2, pc2, ch2, vr2, gaLo2, gaHi2, gbLo2, gbHi2, opp2, swp2, bage2, lhi2, llo2] = request.security(syminfo.tickerid, "2", f_tfFacts(), barmerge.gaps_off, barmerge.lookahead_off)

