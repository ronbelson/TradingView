[c10, mf10, mm10, ms10, mx10, lf10, lm10, ls10, dp10, r1410, r710, ml10, sl10, hi10, rh10, rl10, rp10, stk10, pvs10, fl10, bu10, bp10, ph10, ph210, pl10, pl210, srh10, srl10, zc10, pc10, ch10, vr10, gaLo10, gaHi10, gbLo10, gbHi10, opp10, swp10, bage10, lhi10, llo10] = request.security(syminfo.tickerid, "10", f_tfFacts(), barmerge.gaps_off, barmerge.lookahead_off)
