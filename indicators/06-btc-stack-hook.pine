     TfPack.new("15m", c15, mf15, mm15, ms15, mx15, lf15, lm15, ls15, dp15, r1415, r715, ml15, sl15, hi15, rh15, rl15, rp15, stk15, pvs15, fl15, bu15, bp15, ph15, ph215, pl15, pl215, srh15, srl15, zc15, pc15, ch15, vr15, gaLo15, gaHi15, gbLo15, gbHi15, opp15, swp15, bage15, lhi15, llo15, poc15, zvALo15, zvAHi15, zvBLo15, zvBHi15, dlt15),
     TfPack.new("30m", c30, mf30, mm30, ms30, mx30, lf30, lm30, ls30, dp30, r1430, r730, ml30, sl30, hi30, rh30, rl30, rp30, stk30, pvs30, fl30, bu30, bp30, ph30, ph230, pl30, pl230, srh30, srl30, zc30, pc30, ch30, vr30, gaLo30, gaHi30, gbLo30, gbHi30, opp30, swp30, bage30, lhi30, llo30, poc30, zvALo30, zvAHi30, zvBLo30, zvBHi30, dlt30),
     TfPack.new("1H", c60, mf60, mm60, ms60, mx60, lf60, lm60, ls60, dp60, r1460, r760, ml60, sl60, hi60, rh60, rl60, rp60, stk60, pvs60, fl60, bu60, bp60, ph60, ph260, pl60, pl260, srh60, srl60, zc60, pc60, ch60, vr60, gaLo60, gaHi60, gbLo60, gbHi60, opp60, swp60, bage60, lhi60, llo60, poc60, zvALo60, zvAHi60, zvBLo60, zvBHi60, dlt60),
     TfPack.new("2H", c120, mf120, mm120, ms120, mx120, lf120, lm120, ls120, dp120, r14120, r7120, ml120, sl120, hi120, rh120, rl120, rp120, stk120, pvs120, fl120, bu120, bp120, ph120, ph2120, pl120, pl2120, srh120, srl120, zc120, pc120, ch120, vr120, gaLo120, gaHi120, gbLo120, gbHi120, opp120, swp120, bage120, lhi120, llo120, na, na, na, na, na, na),
     TfPack.new("3H", c180, mf180, mm180, ms180, mx180, lf180, lm180, ls180, dp180, r14180, r7180, ml180, sl180, hi180, rh180, rl180, rp180, stk180, pvs180, fl180, bu180, bp180, ph180, ph2180, pl180, pl2180, srh180, srl180, zc180, pc180, ch180, vr180, gaLo180, gaHi180, gbLo180, gbHi180, opp180, swp180, bage180, lhi180, llo180, na, na, na, na, na, na),
     TfPack.new("4H", c240, mf240, mm240, ms240, mx240, lf240, lm240, ls240, dp240, r14240, r7240, ml240, sl240, hi240, rh240, rl240, rp240, stk240, pvs240, fl240, bu240, bp240, ph240, ph2240, pl240, pl2240, srh240, srl240, zc240, pc240, ch240, vr240, gaLo240, gaHi240, gbLo240, gbHi240, opp240, swp240, bage240, lhi240, llo240, poc240, zvALo240, zvAHi240, zvBLo240, zvBHi240, dlt240),
     TfPack.new("6H", c360, mf360, mm360, ms360, mx360, lf360, lm360, ls360, dp360, r14360, r7360, ml360, sl360, hi360, rh360, rl360, rp360, stk360, pvs360, fl360, bu360, bp360, ph360, ph2360, pl360, pl2360, srh360, srl360, zc360, pc360, ch360, vr360, gaLo360, gaHi360, gbLo360, gbHi360, opp360, swp360, bage360, lhi360, llo360, na, na, na, na, na, na),
     TfPack.new("12H", c720, mf720, mm720, ms720, mx720, lf720, lm720, ls720, dp720, r14720, r7720, ml720, sl720, hi720, rh720, rl720, rp720, stk720, pvs720, fl720, bu720, bp720, ph720, ph2720, pl720, pl2720, srh720, srl720, zc720, pc720, ch720, vr720, gaLo720, gaHi720, gbLo720, gbHi720, opp720, swp720, bage720, lhi720, llo720, na, na, na, na, na, na),
     TfPack.new("Day", cD, mfD, mmD, msD, mxD, lfD, lmD, lsD, dpD, r14D, r7D, mlD, slD, hiD, rhD, rlD, rpD, stkD, pvsD, flD, buD, bpD, phD, ph2D, plD, pl2D, srhD, srlD, zcD, pcD, chD, vrD, gaLoD, gaHiD, gbLoD, gbHiD, oppD, swpD, bageD, lhiD, lloD, na, na, na, na, na, na),
     TfPack.new("3D", c3D, mf3D, mm3D, ms3D, mx3D, lf3D, lm3D, ls3D, dp3D, r143D, r73D, ml3D, sl3D, hi3D, rh3D, rl3D, rp3D, stk3D, pvs3D, fl3D, bu3D, bp3D, ph3D, ph23D, pl3D, pl23D, srh3D, srl3D, zc3D, pc3D, ch3D, vr3D, gaLo3D, gaHi3D, gbLo3D, gbHi3D, opp3D, swp3D, bage3D, lhi3D, llo3D, na, na, na, na, na, na),
     TfPack.new("Week", cW, mfW, mmW, msW, mxW, lfW, lmW, lsW, dpW, r14W, r7W, mlW, slW, hiW, rhW, rlW, rpW, stkW, pvsW, flW, buW, bpW, phW, ph2W, plW, pl2W, srhW, srlW, zcW, pcW, chW, vrW, gaLoW, gaHiW, gbLoW, gbHiW, oppW, swpW, bageW, lhiW, lloW, na, na, na, na, na, na))


r7c = ta.rsi(close, rsiLen)
var int bstC = 0
var float bhhC = low
var float bllC = high
var float lastHHpC = 0.0
var float lastLLpC = 0.0
var float oppPxC = na
var float swingPctC = na
var string lastBubble = "-"
var float lastFiredBubPx = na
bool newHighBubble = false
bool newLowBubble = false
bool extremeMoved = false
if bstC == 2 and r7c >= rsiOB
    bhhC := high
    lastBubble := lastHHpC < high ? "HH" : "LH"
    oppPxC := bllC
    swingPctC := bllC != 0 ? (high - bllC) / bllC * 100.0 : na
    lastLLpC := bllC
    bstC := 1
    newHighBubble := true
if bstC == 1 and r7c <= rsiOS
    bllC := low
    lastBubble := lastLLpC < low ? "HL" : "LL"
    oppPxC := bhhC
    swingPctC := bhhC != 0 ? (bhhC - low) / bhhC * 100.0 : na
    lastHHpC := bhhC
    bstC := 2
    newLowBubble := true
if r7c >= rsiOB
    if high >= bhhC
        if high != bhhC
            extremeMoved := true
        bhhC := high
        lastBubble := lastHHpC < high ? "HH" : "LH"
        if not na(oppPxC) and oppPxC != 0
            swingPctC := (high - oppPxC) / oppPxC * 100.0
    bstC := 1
if r7c <= rsiOS
    if low <= bllC
        if low != bllC
            extremeMoved := true
        bllC := low
        lastBubble := lastLLpC < low ? "HL" : "LL"
        if not na(oppPxC) and oppPxC != 0
            swingPctC := (oppPxC - low) / oppPxC * 100.0
    bstC := 2

[macdLine, signalLine, hist] = ta.macd(close, macdFast, macdSlow, macdSig)
rsi14 = ta.rsi(close, rsi14Len)

float zapFollowC = ta.ema(close, zapFollowLen)
[zMlC, zSlC, _] = ta.macd(close, zapMacdFast, zapMacdSlow, zapMacdSig)
bool zapMacdOkC = zMlC > zMlC[1] or zMlC >= zSlC
float zcC = close > zapFollowC and zapMacdOkC ? 1.0 : -1.0
if rsi14 > 70
    zcC := 2.0
if rsi14 < 30
    zcC := -2.0
float pFastC = ta.sma(close, pinkFast)
float pMidC = ta.sma(close, pinkMid)
float pSlowC = ta.sma(close, pinkSlow)
bool pinkOnC = pFastC > pMidC and pMidC > pSlowC and pFastC > pFastC[1] and pMidC > pMidC[1] and pSlowC > pSlowC[1] and macdLine > signalLine
bool stackedDownC = pFastC < pMidC and pMidC < pSlowC
float pcC = pinkOnC ? 1.0 : stackedDownC and not (macdLine > signalLine) ? -1.0 : 0.0
float chHiC = ta.rma(high, pinkChannelLen)
float chLoC = ta.rma(low, pinkChannelLen)
float chAvgC = ta.rma(ohlc4, pinkPriceAvgLen)
float chC = chAvgC > chHiC ? 1.0 : chAvgC < chLoC ? -1.0 : 0.0
float volMaC = ta.sma(volume, volMaLen)
float vrC = not na(volMaC) and volMaC > 0 ? volume / volMaC : 1.0

bubChanged(cur, prev) =>
    cur != prev and cur != "-" and cur != ""

float chartBubPx = bstC == 1 ? bhhC : bstC == 2 ? bllC : na
bool letterFire = bubChanged(lastBubble, lastBubble[1])
bool flipFire = newHighBubble or newLowBubble
bool pxFire = fireOnPxUpdate and extremeMoved and lastBubble != "-" and lastBubble != "" and (na(lastFiredBubPx) or chartBubPx != lastFiredBubPx)

// Alert on chart TF (1m). Full multi-TF pack still sent.
bool urgentFire = letterFire or flipFire
fire = urgentFire or pxFire

triggerTfs = ""
triggerTfs := fire ? "chart:" + lastBubble : ""
if fire and flipFire
    triggerTfs := triggerTfs + "|flip"
if fire and pxFire and not urgentFire
    triggerTfs := triggerTfs + "|px"

jsonEsc(s) =>
    str.replace_all(str.replace_all(s, "\\", "/"), '"', "'")

jsonNum(v) =>
    na(v) ? "null" : str.tostring(v, format.mintick)

jsonPct(v) =>
    na(v) ? "null" : str.tostring(v, "#.####")

jsonBit(fl, div) =>
    int(fl / div) % 2 == 1 ? "true" : "false"

zapTxt(z) =>
    z == 1 ? "GREEN" : z == -1 ? "RED" : z == 2 ? "PURPLE" : z == -2 ? "GRAY" : "-"

pinkTxt(p) =>
    p == 1 ? "GREEN" : p == -1 ? "RED" : "GRAY"

chTxt(c) =>
    c == 1 ? "up" : c == -1 ? "down" : "mid"

tfOne(t) =>
    string pvsTxt = t.pvs == 1 ? "above_upper" : t.pvs == 2 ? "below_lower" : t.pvs == 3 ? "inside" : t.pvs == 4 ? "at_lower" : t.pvs == 5 ? "at_upper" : "none"
    string stkTxt = t.stk == 1 ? "bull" : t.stk == -1 ? "bear" : "mixed"
    // Full rows only on decision TFs. Others lean (bub letter still present). Alert size limit.
    bool lean = not (t.name == "15m" or t.name == "30m" or t.name == "1H" or t.name == "4H" or t.name == "Day")
    string out = ""
    if lean
        out := (
             '{"tf":"' + t.name + '"' +
             ',"c":' + jsonNum(t.c) +
             ',"mf":' + jsonNum(t.mf) +
             ',"mm":' + jsonNum(t.mm) +
             ',"ms":' + jsonNum(t.ms) +
             ',"stk":"' + stkTxt + '"' +
             ',"r14":' + (na(t.r14) ? "null" : str.tostring(t.r14, "#.##")) +
             ',"mAbove":' + jsonBit(t.fl, 2) +
             ',"bub":"' + t.bub + '"' +
             ',"bubPx":' + jsonNum(t.bubPx) +
             ',"oppPx":' + jsonNum(t.oppPx) +
             ',"swingPct":' + (na(t.swingPct) ? "null" : str.tostring(t.swingPct, "#.##")) +
             ',"srl":' + jsonNum(t.srl) +
             ',"srh":' + jsonNum(t.srh) +
             ',"zap":"' + zapTxt(t.zc) + '"' +
             ',"pink":"' + pinkTxt(t.pc) + '"' +
             ',"channel":"' + chTxt(t.ch) + '"' +
             ',"volRatio":' + (na(t.vr) ? "null" : str.tostring(t.vr, "#.##")) +
             '}')
    else
        out := (
         '{"tf":"' + t.name + '"' +
         ',"c":' + jsonNum(t.c) +
         ',"mf":' + jsonNum(t.mf) +
         ',"mm":' + jsonNum(t.mm) +
         ',"ms":' + jsonNum(t.ms) +
         ',"mx":' + jsonNum(t.mx) +
         ',"stk":"' + stkTxt + '"' +
         ',"r14":' + (na(t.r14) ? "null" : str.tostring(t.r14, "#.##")) +
         ',"ml":' + jsonNum(t.ml) +
         ',"sl":' + jsonNum(t.sl) +
         ',"hi":' + jsonNum(t.hi) +
         ',"mAbove":' + jsonBit(t.fl, 2) +
         ',"hRise":' + jsonBit(t.fl, 16) +
         ',"hFall":' + jsonBit(t.fl, 32) +
         ',"bothLo":' + jsonBit(t.fl, 128) +
         ',"bothHi":' + jsonBit(t.fl, 256) +
         ',"xUp":' + jsonBit(t.fl, 512) +
         ',"xDn":' + jsonBit(t.fl, 1024) +
         ',"rh":' + jsonNum(t.rh) +
         ',"rl":' + jsonNum(t.rl) +
         ',"pvs":"' + pvsTxt + '"' +
         ',"bub":"' + t.bub + '"' +
         ',"bubPx":' + jsonNum(t.bubPx) +
         ',"oppPx":' + jsonNum(t.oppPx) +
         ',"swingPct":' + (na(t.swingPct) ? "null" : str.tostring(t.swingPct, "#.##")) +
         ',"ph":' + jsonNum(t.ph) +
         ',"ph2":' + jsonNum(t.ph2) +
         ',"pl":' + jsonNum(t.pl) +
         ',"pl2":' + jsonNum(t.pl2) +
         ',"srh":' + jsonNum(t.srh) +
         ',"srl":' + jsonNum(t.srl) +
         ',"zap":"' + zapTxt(t.zc) + '"' +
         ',"pink":"' + pinkTxt(t.pc) + '"' +
         ',"channel":"' + chTxt(t.ch) + '"' +
         ',"volRatio":' + (na(t.vr) ? "null" : str.tostring(t.vr, "#.##")) +
         ',"poc":' + jsonNum(t.poc) +
         ',"deltaPct":' + (na(t.deltaPct) ? "null" : str.tostring(t.deltaPct, "#.##")) +
         ',"gapAboveLo":' + jsonNum(t.gaLo) +
         ',"gapAboveHi":' + jsonNum(t.gaHi) +
         ',"gapBelowLo":' + jsonNum(t.gbLo) +
         ',"gapBelowHi":' + jsonNum(t.gbHi) +
         ',"zvAboveLo":' + jsonNum(t.zvALo) +
         ',"zvAboveHi":' + jsonNum(t.zvAHi) +
         ',"zvBelowLo":' + jsonNum(t.zvBLo) +
         ',"zvBelowHi":' + jsonNum(t.zvBHi))
        if t.name == "4H"
            out := out + ',"pf":' + jsonNum(pf240) + ',"pm":' + jsonNum(pm240) + ',"ps":' + jsonNum(ps240)
        if t.name == "Day"
            out := out + ',"pf":' + jsonNum(pfD) + ',"pm":' + jsonNum(pmD) + ',"ps":' + jsonNum(psD)
        out := out + '}'
    out

tfsJson(arr) =>
    string s = "["
    int n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            if i > 0
                s := s + ","
            s := s + tfOne(array.get(arr, i))
    s := s + "]"
    s

// Meter bubble strip only (same 12 TFs as Meter board, letter+px)
boardJson(arr) =>
    string s = "["
    int n = array.size(arr)
    bool first = true
    if n > 0
        for i = 0 to n - 1
            TfPack t = array.get(arr, i)
            if t.name != "3D" and t.name != "Week"
                if not first
                    s := s + ","
                first := false
                s := s + '{"tf":"' + t.name + '","bub":"' + t.bub + '","bubPx":' + jsonNum(t.bubPx) + "}"
    s := s + "]"
    s

hookPayload() =>
    string chj = "{"
    chj := chj + '"bubble":"' + jsonEsc(lastBubble) + '",'
    chj := chj + '"bubblePx":' + jsonNum(chartBubPx) + ","
    chj := chj + '"oppPx":' + jsonNum(oppPxC) + ","
    chj := chj + '"swingPct":' + (na(swingPctC) ? "null" : str.tostring(swingPctC, "#.##")) + '}'
    string p = "{"
    p := p + '"type":"scene",'
    p := p + '"schema":"facts_v8_meter",'
    p := p + '"symbol":"' + syminfo.ticker + '",'
    p := p + '"exchange":"' + syminfo.prefix + '",'
    p := p + '"chartTf":"' + timeframe.period + '",'
    p := p + '"time":' + str.tostring(time) + ","
    p := p + '"price":' + str.tostring(close, format.mintick) + ","
    p := p + '"open":' + str.tostring(open, format.mintick) + ","
    p := p + '"high":' + str.tostring(high, format.mintick) + ","
    p := p + '"low":' + str.tostring(low, format.mintick) + ","
    p := p + '"barConfirmed":' + (barstate.isconfirmed ? "true" : "false") + ","
    p := p + '"dayPct":' + (na(dayPct) ? "null" : str.tostring(dayPct, "#.##")) + ","
    p := p + '"dayAboveZero":' + (dayAboveZero ? "true" : "false") + ","
    p := p + '"regime":"' + (isBull ? "bull" : "bear") + '",'
    p := p + '"regimeScope":"yearly_manual",'
    p := p + '"trigger":"' + jsonEsc(triggerTfs) + '",'
    p := p + '"centerTf":"4H",'
    p := p + '"chart":' + chj + ","
    p := p + '"board":' + boardJson(tfPacks) + ","
    p := p + '"tfs":' + tfsJson(tfPacks) + "}"
    p

// Hybrid: new bubble / letter → send once in this bar (can be mid-bar).
// Price-only move → wait for 1m close.
bool sendUrgent = enableHook and urgentFire and (hybridUrgent or barstate.isconfirmed)
bool sendPxClose = enableHook and pxFire and not urgentFire and barstate.isconfirmed
if sendUrgent
    alert(hookPayload(), hybridUrgent ? alert.freq_once_per_bar : alert.freq_once_per_bar_close)
    lastFiredBubPx := chartBubPx
if sendPxClose
    alert(hookPayload(), alert.freq_once_per_bar_close)
    lastFiredBubPx := chartBubPx

plotshape(showFireMark and (sendUrgent or sendPxClose), title="Hook fire", style=shape.diamond, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="WH")
plotchar(showFireMark and lastBubble != "-" and lastBubble != "", title="Bubble letter", char="", location=location.belowbar, color=color.new(color.gray, 100))
if showFireMark and barstate.islast
    var table dbg = table.new(position.top_right, 1, 3, bgcolor=color.new(color.black, 70))
    table.cell(dbg, 0, 0, "Hook " + lastBubble, text_color=color.white, text_size=size.small)
    string fireLbl = sendUrgent ? (hybridUrgent ? "FIRE now" : "FIRE close") : sendPxClose ? "FIRE px close" : fire ? "armed" : "wait"
    table.cell(dbg, 0, 1, fireLbl, text_color=fire ? color.orange : color.gray, text_size=size.small)
    table.cell(dbg, 0, 2, na(chartBubPx) ? "-" : str.tostring(chartBubPx, format.mintick), text_color=color.aqua, text_size=size.small)

plot(na, title="Hook placeholder", display=display.none)
