[pfD, pmD, psD] = request.security(syminfo.tickerid, "D", f_pinkPx(), barmerge.gaps_off, barmerge.lookahead_off)

// Day % — same as Meter
dayOpen = request.security(syminfo.tickerid, dayTf, open, barmerge.gaps_off, barmerge.lookahead_off)
dayPct = not na(dayOpen) and dayOpen != 0 ? (close - dayOpen) / dayOpen * 100.0 : na
dayAboveZero = not na(dayPct) and dayPct >= 0

// Volume profile: 15m / 30m / 1H / 4H (facts only · no boxes · memory-safe)
[poc15, zvALo15, zvAHi15, zvBLo15, zvBHi15, dlt15] = request.security(syminfo.tickerid, "15", f_vpOnly(), barmerge.gaps_off, barmerge.lookahead_off)
[poc30, zvALo30, zvAHi30, zvBLo30, zvBHi30, dlt30] = request.security(syminfo.tickerid, "30", f_vpOnly(), barmerge.gaps_off, barmerge.lookahead_off)
[poc60, zvALo60, zvAHi60, zvBLo60, zvBHi60, dlt60] = request.security(syminfo.tickerid, "60", f_vpOnly(), barmerge.gaps_off, barmerge.lookahead_off)
[poc240, zvALo240, zvAHi240, zvBLo240, zvBHi240, dlt240] = request.security(syminfo.tickerid, "240", f_vpOnly(), barmerge.gaps_off, barmerge.lookahead_off)

// Meter board order (short→long) then 3D/Week for higher context
tfPacks = array.from(
     TfPack.new("2m", c2, mf2, mm2, ms2, mx2, lf2, lm2, ls2, dp2, r142, r72, ml2, sl2, hi2, rh2, rl2, rp2, stk2, pvs2, fl2, bu2, bp2, ph2, ph22, pl2, pl22, srh2, srl2, zc2, pc2, ch2, vr2, gaLo2, gaHi2, gbLo2, gbHi2, opp2, swp2, bage2, lhi2, llo2, na, na, na, na, na, na),
