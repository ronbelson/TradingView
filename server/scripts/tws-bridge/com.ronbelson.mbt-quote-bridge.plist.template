<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install-mac.sh writes the real plist with absolute paths.
  Label: com.ronbelson.mbt-quote-bridge
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ronbelson.mbt-quote-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WATCH_SH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__BRIDGE_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__BRIDGE_DIR__/logs/launchd-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>__BRIDGE_DIR__/logs/launchd-bridge.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>CHEF_QUOTE_URL</key>
    <string>__CHEF_QUOTE_URL__</string>
    <key>CHEF_QUOTE_GET_URL</key>
    <string>__CHEF_QUOTE_URL__</string>
    <key>CHEF_SECRET_FILE</key>
    <string>__SECRET_FILE__</string>
    <key>MBT_LOCAL_SYMBOL</key>
    <string>__MBT_LOCAL_SYMBOL__</string>
    <key>IB_HOST</key>
    <string>127.0.0.1</string>
    <key>IB_PORT</key>
    <string>__IB_PORT__</string>
    <key>STALE_SEC</key>
    <string>45</string>
    <key>HEALTH_SEC</key>
    <string>15</string>
  </dict>
</dict>
</plist>
